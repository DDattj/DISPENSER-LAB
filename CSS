/* 기본 리셋 */
body.modal-open {
  /* 모달이 열렸을 때 배경 스크롤 방지 */
  overflow: hidden; 
}

/* 유닛 버튼 (디자인에 맞게 변경하세요) */
.unit-button {
  padding: 10px 20px;
  cursor: pointer;
}

/* 모달 전체 오버레이 (배경) */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background-color: rgba(0, 0, 0, 0.4); /* 반투명 배경 */
  z-index: 1000;
  
  /* 숨김 처리 */
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
  
  /* 모달 오버레이 자체에서 스크롤이 가능하도록 설정 */
  overflow-y: auto; 
}

/* 모달이 활성화되었을 때의 클래스 */
.modal-overlay.active {
  opacity: 1;
  visibility: visible;
}

/* 종이처럼 보이는 실제 콘텐츠 박스 */
.modal-content {
  background-color: #ffffff;
  width: 100%;
  max-width: 900px; /* 노션처럼 적당한 최대 너비 설정 */
  min-height: 100vh; /* 화면 전체 높이만큼 덮기 */
  margin: 40px auto 0 auto; /* 상단 여백 40px 띄우고 중앙 정렬 */
  padding: 60px;
  border-radius: 20px 20px 0 0; /* 위쪽만 둥글게 */
  position: relative;
  
  /* 하단에서 올라오는 애니메이션 준비 */
  transform: translateY(100px);
  transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
}

/* 활성화 시 원래 위치로 복귀 */
.modal-overlay.active .modal-content {
  transform: translateY(0);
}

/* 닫기 버튼 */
.close-btn {
  position: absolute;
  top: 20px;
  right: 20px;
  background: none;
  border: none;
  font-size: 24px;
  cursor: pointer;
  color: #888;
}

/* 콘텐츠 내부 스타일 (참고용) */
.badge {
  background: #fde4e4;
  color: #c94c4c;
  padding: 5px 10px;
  border-radius: 4px;
  font-size: 14px;
}
.notion-style-box {
  background: #f7f7f5;
  padding: 15px;
  border-radius: 8px;
  margin-top: 20px;
  font-family: sans-serif;
}
