/* Notion Style Upload Modal */
.modal-overlay-upload { 
  position: fixed; inset: 0; background: rgba(33,31,28,0.45); display: none; align-items: flex-start; justify-content: center; z-index: 50; 
  padding: 60px 0 0 0; backdrop-filter: blur(2px);
}
.modal-overlay-upload.open { display: flex; }

.notion-modal { 
  width: 100%; height: 100%; max-width: 900px; background: #fff; border-radius: 12px 12px 0 0; 
  box-shadow: 0 -10px 40px rgba(0,0,0,0.15); display: flex; flex-direction: column; position: relative;
  overflow-y: auto;
}

.notion-header-image-container {
  width: 100%; height: 30vh; min-height: 200px; background: #f3f3f2; position: relative;
  display: flex; align-items: center; justify-content: center; overflow: hidden;
}
.notion-header-image-preview {
  width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; display: none;
}
.notion-header-image-btn {
  position: relative; z-index: 10; padding: 8px 16px; background: rgba(255,255,255,0.8);
  border: 1px solid var(--line); border-radius: 6px; font-size: 13px; cursor: pointer; backdrop-filter: blur(4px);
}
.notion-header-image-btn:hover { background: #fff; }

.notion-modal-content-area { padding: 40px 8vw 80px; display: flex; flex-direction: column; flex: 1; }

.notion-title-input { 
  font-family: inherit; font-size: clamp(32px, 4vw, 40px); font-weight: 800; border: none; outline: none; width: 100%; 
  color: var(--ink); background: transparent; padding: 0; margin-bottom: 24px; letter-spacing: -0.02em;
}
.notion-title-input::placeholder { color: #e6e6e6; font-weight: 800; }

.notion-properties { display: flex; flex-direction: column; gap: 14px; margin-bottom: 20px; }
.notion-property-row { display: flex; align-items: flex-start; font-size: 14px; min-height: 36px; padding: 4px 0;}
.notion-property-label { width: 140px; color: #767670; display: flex; align-items: center; gap: 8px; font-weight: 500; height: 28px; }
.notion-property-value { flex: 1; }

.notion-select, .notion-file { 
  font-family: inherit; font-size: 14px; border: none; outline: none; background: transparent; 
  color: var(--ink); width: 100%; cursor: pointer; padding: 6px 8px; margin-left: -8px; border-radius: 4px;
  transition: background 0.1s ease; height: 28px; line-height: 16px;
}
.notion-select:hover, .notion-file:hover { background: #f3f3f2; }
input[type="text"].notion-select { cursor: text; }

#editor-container { height: auto; min-height: 400px; font-family: inherit; font-size: 16px; color: var(--ink); }
.ql-toolbar.ql-snow { border: none !important; border-bottom: 1px solid var(--line) !important; padding: 12px 0 !important; margin-bottom: 16px; }
.ql-container.ql-snow { border: none !important; font-family: inherit; font-size: 16px; height: auto !important; }
.ql-editor { padding: 0 !important; overflow-y: visible !important; } 
.ql-editor.ql-blank::before { left: 0; color: #ccc; font-style: normal; }

.notion-divider { border: none; border-top: 1px solid #ededeb; margin: 16px 0 24px 0; width: 100%; }

.notion-modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 40px; }
.notion-btn-save, .notion-btn-cancel { 
  font-family: inherit; padding: 8px 16px; border-radius: 6px; font-size: 14px; font-weight: 600; cursor: pointer; border: none; transition: all 0.15s ease;
}
.notion-btn-save { background: #2383e2; color: white; display: flex; align-items: center; justify-content: center; min-width: 60px; } 
.notion-btn-save:hover { background: #1a6fca; }
.notion-btn-save:disabled { opacity: 0.5; cursor: not-allowed; }
.notion-btn-cancel { background: transparent; color: var(--ink-soft); }
.notion-btn-cancel:hover { background: #efefef; }

.notion-modal .status-msg { font-size: 13px; color: var(--ink-soft); margin-top: 12px; min-height: 18px; text-align: right; }

/* Project Detail Modal */
.project-modal-overlay {
  position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
  background-color: rgba(0, 0, 0, 0.4); z-index: 1000; opacity: 0; visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease; overflow-y: auto;
}
.project-modal-overlay.active { opacity: 1; visibility: visible; }
.project-modal-content {
  background-color: #ffffff; width: 90%; max-width: 900px;
  min-height: calc(100vh - 80px); margin: 40px auto; padding: 40px 60px 60px;
  border-radius: 20px; position: relative; transform: translateY(100px);
  transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
}
@media (max-width: 640px) { .project-modal-content { width: 92%; padding: 30px 20px 40px; } }
.project-modal-overlay.active .project-modal-content { transform: translateY(0); }

.modal-sticky-header { position: sticky; top: 30px; display: flex; justify-content: flex-end; gap: 10px; z-index: 10; height: 0; }
.modal-cover-img { width: 100%; max-height: 400px; object-fit: cover; border-radius: 12px; margin-bottom: 24px; display: none; }

.modal-body-content { line-height: 1.8; font-size: 16px; color: var(--ink); word-break: break-word; }
.modal-body-content img { max-width: 100%; height: auto; border-radius: 8px; margin: 16px 0; display: block; }
